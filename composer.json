{
    "name": "pixovoid/laravel-cloudflared",
    "type": "library",
    "description": "A Laravel package to create and manage Cloudflare Tunnels for local development (fork by PixoVoid)",
    "keywords": ["cloudflare", "cloudflared", "laravel", "tunnel", "herd"],
    "homepage": "https://github.com/PixoVoid-net/laravel-cloudflared",
    "support": {
        "source": "https://github.com/PixoVoid-net/laravel-cloudflared",
        "issues": "https://github.com/PixoVoid-net/laravel-cloudflared/issues"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Aerni",
            "email": "hello@michaelaerni.ch",
            "homepage": "https://michaelaerni.ch",
            "role": "Developer"
        },
        {
            "name": "PixoVoid",
            "homepage": "https://PixoVoid.dev",
            "role": "Fork maintainer"
        }
    ],
    "require": {
        "php": "^8.4",
        "cloudflare/sdk": "^1.4",
        "illuminate/support": "^12.41"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.8",
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "PixoVoid\\Cloudflared\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PixoVoid\\Cloudflared\\CloudflaredServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
